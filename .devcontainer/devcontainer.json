{
  "name": "SuperKart Sales Forecasting",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "forwardPorts": [7860, 8501],
  "portsAttributes": {
    "7860": {
      "label": "Flask Backend API",
      "onAutoForward": "notify"
    },
    "8501": {
      "label": "Streamlit Frontend",
      "onAutoForward": "openBrowser"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "pip install -r backend_files/requirements.txt && pip install -r frontend_files/requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
