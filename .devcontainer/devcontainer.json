{
  "name": "SuperKart Sales Forecasting",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "forwardPorts": [7860, 8501],
  "portsAttributes": {
    "7860": {"label": "Flask Backend API", "onAutoForward": "notify"},
    "8501": {"label": "Streamlit Frontend", "onAutoForward": "openBrowser"}
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "echo 'Run: docker compose up --build -d to start both containers'",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker"]
    }
  }
}
